#!/bin/sh
# Runs before every commit, from any machine or tool: git config core.hooksPath .githooks
# Skip it once, on purpose, with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0

# Files that never belong in this repo
sealed=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(\.env[^/]*|[^/]*service-account[^/]*\.json|github-recovery-codes\.txt|[^/]*\.(pem|p12|key))$')
if [ -n "$sealed" ]; then
  echo "pre-commit: these files hold credentials and stay out of git:" >&2
  echo "$sealed" | sed 's/^/  - /' >&2
  fail=1
fi

# Keys and tokens in the lines being added (names only, never the value)
keys='AIza[0-9A-Za-z_-]{35}|sk-ant-[0-9A-Za-z_-]{20,}|sk-[0-9A-Za-z]{32,}|gh[pousr]_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{40,}|xox[abprs]-[0-9A-Za-z-]{10,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
  git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' | grep -qE "$keys" && echo "$file"
done)
if [ -n "$hits" ]; then
  echo "pre-commit: something shaped like a key or token is being added in:" >&2
  echo "$hits" | sed 's/^/  - /' >&2
  fail=1
fi

# The session file, as the pages read it, and the stage timer's arithmetic
node scripts/check-session.js || fail=1
node scripts/test-stage-timer.js > /dev/null || fail=1

[ $fail -eq 0 ] || echo "pre-commit: commit stopped. Fix the above, or skip once with --no-verify." >&2
exit $fail
